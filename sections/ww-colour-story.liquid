{%- comment -%}
  Wander Way demo – colour story. One block per colour; the block whose
  "option value" matches the selected variant's Color is shown. Follows
  Dawn's variant picker (PUB_SUB_EVENTS.variantChange) and drives it back:
  the swatches here click the matching input in the main picker.
  Hides itself when no block matches the product's colours.
{%- endcomment -%}
{%- liquid
  assign colour_index = -1
  assign colour_values = ''
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign colour_index = forloop.index0
      assign colour_values = option.values | join: '|' | downcase | split: '|'
      break
    endif
  endfor

  assign current = ''
  if colour_index >= 0
    assign current = product.selected_or_first_available_variant.options[colour_index] | downcase
  endif

  assign matching_blocks = 0
  assign active_found = false
  for block in section.blocks
    assign value = block.settings.option_value | downcase | strip
    if colour_values contains value
      assign matching_blocks = matching_blocks | plus: 1
      if value == current
        assign active_found = true
      endif
    endif
  endfor
-%}

{%- if matching_blocks > 0 -%}
  {{ 'ww-product.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ww-colour-story.js' | asset_url }}" defer="defer"></script>

  <ww-colour-story class="ww-colour-story ww-section ww-scope page-width" data-colour-index="{{ colour_index }}">
    <div class="ww-colour-story__card">
      {%- assign shown = false -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign value = b.option_value | downcase | strip
          unless colour_values contains value
            continue
          endunless
          assign is_active = false
          if value == current
            assign is_active = true
          elsif active_found == false and shown == false
            assign is_active = true
          endif
          if is_active
            assign shown = true
          endif
          assign value_handle = b.option_value | handleize
        -%}
        <div
          class="ww-colour-story__panel{% if is_active %} is-active{% endif %}"
          data-colour="{{ value | escape }}"
          style="--ww-story-tint: var(--ww-tint-{{ value_handle }}, var(--ww-surface-2)); --ww-dot: var(--ww-swatch-{{ value_handle }}, var(--ww-border-strong)); --ww-story-position: {{ b.image_position }};"
          {% unless is_active %}
            inert aria-hidden="true"
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="ww-colour-story__media">
            {%- liquid
              assign alt = product.title | append: ' in ' | append: b.option_value
              assign fallback = b.fallback_image | default: 'daypack-black.jpg'
            -%}
            {%- render 'ww-image',
              image: b.image,
              fallback: fallback,
              alt: alt,
              sizes: '(min-width: 990px) 684px, 100vw',
              class: 'ww-colour-story__img'
            -%}
            {%- if b.label != blank -%}
              <span class="ww-pill ww-colour-story__label">{{ b.label | escape }}</span>
            {%- endif -%}
            <span class="ww-colour-story__dot" aria-hidden="true"></span>
          </div>
          <div class="ww-colour-story__body">
            {%- if section.settings.eyebrow != blank -%}
              <p class="ww-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="ww-h2 ww-colour-story__heading">
              {{- b.heading | escape }}
              {% if b.heading_italic != blank %}<em>{{ b.heading_italic | escape }}</em>{% endif -%}
            </h2>
            {%- if b.text != blank -%}
              <p class="ww-colour-story__text">{{ b.text | escape }}</p>
            {%- endif -%}
            <dl class="ww-colour-story__facts">
              <div>
                <dt>{{ section.settings.finish_label | escape }}</dt>
                <dd>{{ b.finish | escape }}</dd>
              </div>
              <div>
                <dt>{{ section.settings.hardware_label | escape }}</dt>
                <dd>{{ b.hardware | escape }}</dd>
              </div>
              <div>
                <dt>{{ section.settings.pairs_label | escape }}</dt>
                <dd>{{ b.pairs_with | escape }}</dd>
              </div>
            </dl>
            <div class="ww-colour-story__swatches" role="group" aria-label="{{ section.settings.swatches_label | escape }}">
              {%- for swatch_block in section.blocks -%}
                {%- assign swatch_value = swatch_block.settings.option_value | downcase | strip -%}
                {%- if colour_values contains swatch_value -%}
                  <button
                    type="button"
                    class="ww-colour-story__swatch"
                    data-value="{{ swatch_block.settings.option_value | escape }}"
                    aria-label="{{ swatch_block.settings.option_value | escape }}"
                    aria-pressed="{% if swatch_value == value %}true{% else %}false{% endif %}"
                    style="--ww-dot: var(--ww-swatch-{{ swatch_block.settings.option_value | handleize }}, var(--ww-border-strong));"
                  >
                    <span></span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </ww-colour-story>
{%- endif -%}

{% schema %}
{
  "name": "WW: Colour story",
  "tag": "div",
  "class": "section-ww-colour-story",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Colour story · Custom section" },
    { "type": "text", "id": "finish_label", "label": "Finish label", "default": "Finish" },
    { "type": "text", "id": "hardware_label", "label": "Hardware label", "default": "Hardware" },
    { "type": "text", "id": "pairs_label", "label": "Pairs with label", "default": "Pairs with" },
    { "type": "text", "id": "swatches_label", "label": "Swatches label (screen readers)", "default": "Choose colour" }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colour",
      "settings": [
        {
          "type": "text",
          "id": "option_value",
          "label": "Color option value",
          "info": "Must equal the variant's Color value, e.g. Black.",
          "default": "Black"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback image (theme asset)",
          "info": "Used when no image is picked, e.g. daypack-black.jpg.",
          "default": "daypack-black.jpg"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focus",
          "options": [
            { "value": "50% 35%", "label": "Upper" },
            { "value": "50% 50%", "label": "Centre" },
            { "value": "50% 60%", "label": "Lower" }
          ],
          "default": "50% 50%"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "No. 01 — Black" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Black, for" },
        { "type": "text", "id": "heading_italic", "label": "Italic last word", "default": "everywhere." },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "finish", "label": "Finish", "default": "Matte nylon" },
        { "type": "text", "id": "hardware", "label": "Hardware", "default": "Gunmetal" },
        { "type": "text", "id": "pairs_with", "label": "Pairs with", "default": "Anything" }
      ]
    }
  ],
  "presets": [{ "name": "WW: Colour story", "blocks": [{ "type": "colour" }] }]
}
{% endschema %}
