{%- comment -%}
  Wander Way demo - Color story
  Shows a different image + copy for each colour of the product and swaps it
  instantly when the shopper picks another colour in Dawn's variant picker
  (listens to PUB_SUB_EVENTS.variantChange, no extra requests).

  Content per colour comes from section blocks, so merchants edit it in the
  theme editor. Matching is case-insensitive on the colour option value.
{%- endcomment -%}

{{ 'ww-color-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_option_index = -1
  assign color_names = section.settings.option_names | downcase | split: ','
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for name in color_names
      assign candidate = name | strip
      if option_name == candidate
        assign color_option_index = forloop.parentloop.index0
      endif
    endfor
  endfor

  assign current_variant = product.selected_or_first_available_variant
  assign current_color = ''
  if color_option_index >= 0
    assign current_color = current_variant.options[color_option_index] | downcase | strip
  endif
-%}

{%- if product != blank and section.blocks.size > 0 -%}
  <style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <ww-color-story
      class="ww-color-story page-width section-{{ section.id }}-padding"
      data-section="{{ section.id }}"
      data-product-section="{{ section.settings.product_section_id | escape }}"
      data-option-index="{{ color_option_index }}"
      aria-live="polite"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="ww-color-story__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- assign has_match = false -%}
      {%- for block in section.blocks -%}
        {%- assign block_color = block.settings.color_name | downcase | strip -%}
        {%- if block_color == current_color -%}{%- assign has_match = true -%}{%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign block_color = block.settings.color_name | downcase | strip
          assign is_active = false
          if block_color == current_color
            assign is_active = true
          elsif has_match == false and forloop.first
            assign is_active = true
          endif
        -%}
        <div
          class="ww-color-story__panel{% if section.settings.image_position == 'right' %} ww-color-story__panel--reverse{% endif %}"
          data-color="{{ block_color | escape }}"
          {% unless is_active %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="ww-color-story__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '400, 600, 800, 1000, 1200'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="ww-color-story__content">
            {%- if block.settings.swatch != blank -%}
              <span class="ww-color-story__swatch" style="--ww-swatch: {{ block.settings.swatch }};" aria-hidden="true"></span>
            {%- endif -%}
            <p class="ww-color-story__eyebrow caption-with-letter-spacing">{{ block.settings.color_name | escape }}</p>
            {%- if block.settings.heading != blank -%}
              <h3 class="h2">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </ww-color-story>
  </div>

  <script src="{{ 'ww-color-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "WW: Color story",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One product, every mood" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "option_names",
      "label": "Colour option names",
      "info": "Comma-separated option names to treat as colour.",
      "default": "Color,Colour,Boja,Farbe,Couleur"
    },
    {
      "type": "text",
      "id": "product_section_id",
      "label": "Main product section ID (advanced)",
      "info": "Leave empty to react to any product form on the page."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "color_panel",
      "name": "Colour panel",
      "settings": [
        { "type": "text", "id": "color_name", "label": "Colour (must match the variant option value)", "default": "Black" },
        { "type": "color", "id": "swatch", "label": "Swatch" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made for late evenings" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe what makes this colour special: mood, styling tips, what to wear it with.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW: Color story",
      "blocks": [
        { "type": "color_panel", "settings": { "color_name": "Black", "heading": "Made for late evenings" } },
        { "type": "color_panel", "settings": { "color_name": "White", "heading": "Light, clean, everyday" } }
      ]
    }
  ]
}
{% endschema %}
