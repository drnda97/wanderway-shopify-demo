{%- comment -%}
  Wander Way demo - Testimonials carousel
  - CSS scroll-snap slider (no library), keyboard and screen-reader friendly
  - Optional product link per testimonial (product picker)
  - Average rating summary computed in Liquid from the blocks
{%- endcomment -%}

{{ 'ww-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rating_total = 0
  for block in section.blocks
    assign rating_total = rating_total | plus: block.settings.rating
  endfor
  if section.blocks.size > 0
    assign rating_avg = rating_total | times: 1.0 | divided_by: section.blocks.size | round: 1
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <ww-testimonials
    class="ww-testimonials page-width"
    style="--ww-pad-top: {{ section.settings.padding_top }}px; --ww-pad-bottom: {{ section.settings.padding_bottom }}px; --ww-per-view: {{ section.settings.per_view }};"
  >
    <div class="ww-testimonials__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="h1 ww-testimonials__heading" id="WWTestimonials-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.blocks.size > 0 and section.settings.show_summary -%}
          <p class="ww-testimonials__summary">
            <span class="ww-stars" style="--ww-rating: {{ rating_avg }};" aria-hidden="true"></span>
            <span>{{ rating_avg }} / 5 &middot; {{ section.blocks.size }} reviews</span>
          </p>
        {%- endif -%}
      </div>
      <div class="ww-testimonials__nav">
        <button type="button" class="ww-testimonials__btn" data-ww-prev aria-label="Previous testimonial">
          <span aria-hidden="true">&larr;</span>
        </button>
        <button type="button" class="ww-testimonials__btn" data-ww-next aria-label="Next testimonial">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>

    <ul
      class="ww-testimonials__track"
      role="list"
      tabindex="0"
      {% if section.settings.heading != blank %}aria-labelledby="WWTestimonials-{{ section.id }}"{% endif %}
      data-ww-track
    >
      {%- for block in section.blocks -%}
        <li class="ww-testimonials__slide" {{ block.shopify_attributes }}>
          <figure class="ww-testimonials__card">
            <span class="ww-stars" style="--ww-rating: {{ block.settings.rating }};" role="img" aria-label="{{ block.settings.rating }} out of 5 stars"></span>
            <blockquote class="ww-testimonials__quote">
              {{- block.settings.quote -}}
            </blockquote>
            <figcaption class="ww-testimonials__author">
              <strong>{{ block.settings.author | escape }}</strong>
              {%- if block.settings.location != blank -%}
                <span>{{ block.settings.location | escape }}</span>
              {%- endif -%}
            </figcaption>
            {%- assign reviewed = block.settings.product -%}
            {%- if reviewed != blank -%}
              <a class="ww-testimonials__product" href="{{ reviewed.url }}">
                {%- if reviewed.featured_image -%}
                  {{ reviewed.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 48, height: 48, alt: '' }}
                {%- endif -%}
                <span>{{ reviewed.title | escape }}</span>
              </a>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </ww-testimonials>
</div>

<script src="{{ 'ww-testimonials.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "WW: Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "checkbox", "id": "show_summary", "label": "Show average rating", "default": true },
    { "type": "range", "id": "per_view", "min": 1, "max": 4, "step": 1, "label": "Cards per view (desktop)", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Sample testimonial text. Replace with a real customer review.</p>" },
        { "type": "text", "id": "author", "label": "Author", "default": "Customer name" },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "product", "id": "product", "label": "Reviewed product (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW: Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Sample customer A", "location": "Demo review", "rating": 5 } },
        { "type": "testimonial", "settings": { "author": "Sample customer B", "location": "Demo review", "rating": 5 } },
        { "type": "testimonial", "settings": { "author": "Sample customer C", "location": "Demo review", "rating": 4 } },
        { "type": "testimonial", "settings": { "author": "Sample customer D", "location": "Demo review", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
