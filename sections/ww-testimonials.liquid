{%- comment -%}
  Wander Way demo – testimonials carousel, two layouts:
  - grid:   intro column (rating summary + controls) and 3 cards that advance
            by one (1 card on mobile). Home page.
  - single: one large card with a "reviewed product" panel tinted with the
            review's colour. Product page.
  Every card carries the "Sample review" tag. Prev/next wrap around.
{%- endcomment -%}
{{ 'ww-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ww-testimonials.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign layout = s.layout
  assign count = section.blocks.size
  assign count_label = count | prepend: '0' | slice: -2, 2
  if count > 99
    assign count_label = count
  endif
-%}

<ww-testimonials
  class="ww-testimonials ww-testimonials--{{ layout }} ww-section ww-scope page-width"
  data-layout="{{ layout }}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handleize }}"
  {% endif %}
>
  <div class="ww-testimonials__intro" data-ww-reveal>
    {%- if s.eyebrow != blank -%}
      <p class="ww-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="ww-h2" id="WWTestimonialsHeading-{{ section.id }}">
      {{- s.heading | escape }}
      {% if s.heading_italic != blank %}<em>{{ s.heading_italic | escape }}</em>{% endif -%}
    </h2>
    {%- if layout == 'grid' and s.rating_value != blank -%}
      <div class="ww-testimonials__summary">
        <span class="ww-testimonials__score">{{ s.rating_value | escape }}</span>
        <div class="ww-testimonials__summary-text">
          <span class="ww-stars ww-testimonials__summary-stars" role="img" aria-label="Average rating {{ s.rating_value | escape }} out of 5">
            {%- for i in (1..5) -%}
              {%- render 'ww-icon', icon: 'star', size: 18 -%}
            {%- endfor -%}
          </span>
          <span class="ww-testimonials__summary-label">{{ s.rating_label | escape }}</span>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if count > 1 -%}
    <div class="ww-testimonials__controls">
      <span class="ww-testimonials__pager" aria-hidden="true">
        <span data-ww-current>01</span> / {{ count_label }}
      </span>
      <span class="ww-testimonials__dots ww-testimonials__dots--controls" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span class="ww-testimonials__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </span>
      <button type="button" class="ww-icon-btn ww-testimonials__btn" data-ww-prev aria-label="{{ s.prev_label | escape }}">
        {%- render 'ww-icon', icon: 'chevron-left', size: 18, stroke: 1.8 -%}
      </button>
      <button type="button" class="ww-icon-btn ww-icon-btn--dark ww-testimonials__btn" data-ww-next aria-label="{{ s.next_label | escape }}">
        {%- render 'ww-icon', icon: 'chevron-right', size: 18, stroke: 1.8 -%}
      </button>
    </div>
  {%- endif -%}

  <div
    class="ww-testimonials__track"
    role="region"
    aria-roledescription="carousel"
    aria-labelledby="WWTestimonialsHeading-{{ section.id }}"
    aria-live="polite"
    tabindex="0"
    data-ww-track
    data-ww-reveal
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign reviewed = b.product | default: all_products[b.product_handle]
        if reviewed.id == blank and product
          assign reviewed = product
        endif
        assign has_product = false
        if reviewed.id != blank
          assign has_product = true
        endif

        assign reviewed_variant = reviewed.selected_or_first_available_variant
        if has_product and b.colour != blank
          for variant in reviewed.variants
            if variant.options contains b.colour
              assign reviewed_variant = variant
              break
            endif
          endfor
        endif
        assign reviewed_image = reviewed_variant.featured_image | default: reviewed.featured_image
        assign reviewed_url = reviewed_variant.url | default: reviewed.url
        assign colour_handle = b.colour | handleize
        assign product_label = reviewed.title
        if b.colour != blank
          assign product_label = product_label | append: ' · ' | append: b.colour
        endif

        assign hidden = false
        if layout == 'grid' and forloop.index > 3
          assign hidden = true
        elsif layout == 'single' and forloop.index > 1
          assign hidden = true
        endif
      -%}
      <figure
        class="ww-review"
        style="--ww-review-tint: var(--ww-tint-{{ colour_handle }}, var(--ww-surface-2));"
        data-ww-slide
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ count }}"
        {% if hidden %}
          hidden
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="ww-review__body">
          <div class="ww-review__top">
            <span class="ww-stars ww-review__stars" role="img" aria-label="{{ b.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i > b.rating -%}
                  {%- render 'ww-icon', icon: 'star', size: 15, class: 'is-off' -%}
                {%- else -%}
                  {%- render 'ww-icon', icon: 'star', size: 15 -%}
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="ww-tag">{{ s.tag | escape }}</span>
          </div>
          <blockquote class="ww-review__quote">“{{ b.quote | escape }}”</blockquote>

          {%- if layout == 'single' -%}
            <figcaption class="ww-review__by">
              <span class="ww-review__who">{{ b.reviewer | escape }}</span>
              <span class="ww-review__when">
                {{- s.verified_label | escape -}}
                {%- if b.date != blank %} · {{ b.date | escape }}{% endif -%}
              </span>
            </figcaption>
            <span class="ww-testimonials__dots ww-review__dots" aria-hidden="true">
              {%- for dot in section.blocks -%}
                <span class="ww-testimonials__dot{% if forloop.index == forloop.parentloop.index %} is-active{% endif %}"></span>
              {%- endfor -%}
            </span>
          {%- else -%}
            <figcaption class="ww-review__by ww-review__by--row">
              {%- if has_product -%}
                <a class="ww-review__thumb" href="{{ reviewed_url }}" aria-label="View {{ product_label | escape }}">
                  {%- if reviewed_image -%}
                    {{ reviewed_image | image_url: width: 120 | image_tag: width: 48, height: 48, alt: '', loading: 'lazy' }}
                  {%- endif -%}
                </a>
              {%- endif -%}
              <span class="ww-review__by-text">
                <span class="ww-review__who">{{ b.reviewer | escape }}</span>
                {%- if has_product -%}
                  <a class="ww-review__product-link" href="{{ reviewed_url }}">{{ product_label | escape }}</a>
                {%- endif -%}
              </span>
            </figcaption>
          {%- endif -%}
        </div>

        {%- if layout == 'single' and has_product -%}
          <a class="ww-review__product" href="{{ reviewed_url }}">
            <span class="ww-review__product-label">{{ s.reviewed_label | escape }}</span>
            <span class="ww-review__product-media">
              {%- if reviewed_image -%}
                {{
                  reviewed_image
                  | image_url: width: 640
                  | image_tag: widths: '120, 320, 480, 640', sizes: '(min-width: 990px) 264px, 48px', alt: '', loading: 'lazy'
                }}
              {%- endif -%}
            </span>
            <span class="ww-review__product-bar">
              <span class="ww-review__product-text">
                <span class="ww-review__product-title">{{ reviewed.title | escape }}</span>
                <span class="ww-review__product-meta">
                  {%- if b.colour != blank %}{{ b.colour | escape }} · {% endif -%}
                  {{- reviewed_variant.price | money_without_trailing_zeros -}}
                </span>
              </span>
              {%- render 'ww-icon', icon: 'arrow-right', size: 18, stroke: 1.8 -%}
            </span>
          </a>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</ww-testimonials>

{% schema %}
{
  "name": "WW: Testimonials",
  "tag": "div",
  "class": "section-ww-testimonials",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid (3 cards, rating summary)" },
        { "value": "single", "label": "Single (large card with product)" }
      ],
      "default": "grid"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Packed, carried," },
    { "type": "text", "id": "heading_italic", "label": "Italic last word", "default": "approved." },
    { "type": "text", "id": "rating_value", "label": "Average rating (grid)", "default": "4.8" },
    { "type": "text", "id": "rating_label", "label": "Rating caption (grid)", "default": "Average from 126 sample reviews" },
    { "type": "text", "id": "tag", "label": "Review tag", "info": "Shown on every card.", "default": "Sample review" },
    { "type": "text", "id": "verified_label", "label": "Verified label (single)", "default": "Verified demo order" },
    { "type": "text", "id": "reviewed_label", "label": "Product panel label (single)", "default": "Reviewed product" },
    { "type": "text", "id": "prev_label", "label": "Previous button label", "default": "Previous reviews" },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next reviews" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets other links jump here, e.g. reviews." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Fits a 14-inch laptop and two days of clothes, and still slides under the seat." },
        { "type": "text", "id": "reviewer", "label": "Reviewer label", "default": "Sample reviewer · Ljubljana" },
        { "type": "text", "id": "date", "label": "Date (single layout)", "default": "Sep 2026" },
        { "type": "product", "id": "product", "label": "Product", "info": "On a product page an empty product means the current one." },
        { "type": "text", "id": "product_handle", "label": "Fallback product handle", "info": "Used when no product is picked." },
        { "type": "text", "id": "colour", "label": "Colour", "info": "Must match a Color option value, e.g. Olive." }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW: Testimonials",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
